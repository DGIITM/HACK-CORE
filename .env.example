APP_NAME=KrishiSathi
ENV=local

LLM_PROVIDER=gemini
# Primary Gemini auth: a free Google AI Studio key (https://aistudio.google.com/apikey).
# Set this and GOOGLE_CLOUD_PROJECT can stay empty for local dev.
GEMINI_API_KEY=
# Fallback Gemini auth (Vertex AI) — the stated production path, only
# used if GEMINI_API_KEY is unset.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
QDRANT_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
